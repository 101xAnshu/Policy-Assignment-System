{
  "name": "@warp/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@warp/audit": "*",
    "@warp/db": "*",
    "@warp/domain": "*",
    "@warp/reconciler": "*",
    "@warp/resolver": "*",
    "@xyflow/react": "^12.11.5",
    "clsx": "^2.1.1",
    "express": "^4.21.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  }
}
